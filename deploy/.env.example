# InkFlow all-in-one 环境配置
# POSTGRES_PASSWORD: 数据库超级用户密码，改成强密码
# JWT_SECRET: 签名密钥，anon/service 密钥由它在容器启动时自动派生，改成一长串随机字符
#   （换新 JWT_SECRET 会让所有已登录会话失效，相当于全部重新登录）

POSTGRES_PASSWORD=please-change-me-32chars-random
JWT_SECRET=please-change-me-64chars-random-string

# 可选：禁止新用户注册（自己用建议注册完账号后设为 true）
# DISABLE_SIGNUP=false
